Program = { SOI ~ "begin" ~ NEWLINE* ~ Statement+ ~ "end" ~ EOI }

Statement = _{
    NEWLINE* ~ Block ~ NEWLINE*
}

ParStatement = _{
    NEWLINE* ~ ParChild ~ NEWLINE*
}

Inline = _{ !KW ~ Id }

Block = _{
    (ParBlock | SeqBlock | Inline)
}

ParChild = _{
    (SeqBlock | Inline)
}

SeqBlock = {
    "begin" ~ Statement+ ~ "end"
}

ParBlock = {
    "parbegin" ~ ParStatement+ ~ "parend"
}

Id = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = _{ " " | "\t" }
NEWLINE    = _{ "\n" | "\r\n" }

KW = { "begin" | "end" | "parbegin" | "parend" }
